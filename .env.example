# Nansen API key — required for `make run`, NOT for `make demo` or `make test`
PRELUDE_NANSEN_KEY=

# Poller budget gates (caller='prelude' in the shared api_usage table)
PRELUDE_MAX_DAY=1500
# NOTE: PRELUDE_MAX_7D=8000 (v1.6 rebase): at ~414 calls/day (3h cadence) the
# 6-day buildathon window needs ≈2,500 calls, so 8,000 holds with ~3× headroom.
# Defense-in-depth at a 106K credit balance — not a planning input.
PRELUDE_MAX_7D=8000

# Optional: shared metering DB with an api_usage table. If unset/absent, every
# call is metered to ./prelude_usage_fallback.db (same schema).
# PRELUDE_USAGE_DB=

# Optional: local state DB (default: ./prelude.db in the repo root)
# PRELUDE_DB=

# Optional: private roster (default: data/roster.json, else the example roster)
# PRELUDE_ROSTER_PATH=
